# ===== 必須 =====
# QR署名とログインCookieの秘密鍵。長いランダム文字列にしてください(例: openssl rand -hex 32)
SECRET=change-me-to-a-long-random-string
# スタッフ(スキャン担当)用パスワード
STAFF_PASSWORD=staff1234
# 管理者用パスワード
ADMIN_PASSWORD=admin1234

# ===== イベント情報(メール本文に使います) =====
EVENT_NAME=サンプルイベント2026
EVENT_DATE=2026年12月20日(日) 開場 17:00 / 開演 18:00
EVENT_VENUE=〇〇ホール
# スキャン画面のゲート名(カンマ区切り)
GATES=ゲートA,ゲートB

# ===== メール送信(SMTP) =====
# SMTP_HOST を空にすると実際には送らず、outbox/ フォルダに .eml ファイルとして保存します(テスト用)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="サンプルイベント事務局 <ticket@example.com>"

# ===== その他 =====
PORT=3000
# DBファイルの場所
DB_PATH=./data/checkin.db
